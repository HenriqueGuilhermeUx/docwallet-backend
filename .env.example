# Render / Flask
PORT=5000
FLASK_DEBUG=false
DATABASE_URL=postgresql://user:password@host:5432/docwallet
JWT_SECRET=troque-por-uma-chave-grande-e-segura
JWT_EXPIRES_HOURS=168
CORS_ORIGINS=https://docwallet.netlify.app,http://localhost:5173,https://localhost,capacitor://localhost,ionic://localhost

# Storage local no Render Disk
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25
DOCWALLET_PUBLIC_URL=https://docwallet.netlify.app

# DocWallet Intelligence
DOCUMENT_INTELLIGENCE_ENABLED=true
DOCUMENT_INTELLIGENCE_PROVIDER=internal
DOCUMENT_INTELLIGENCE_STORE_RAW_TEXT=true
DOCUMENT_INTELLIGENCE_ALLOW_EXTERNAL=false
# Futuro: DOCUMENT_INTELLIGENCE_PROVIDER=docstruct somente quando houver política/LGPD e contrato de subprocessador adequados.

# NexOffice bridge
# Segredo compartilhado exclusivamente entre os backends DocWallet e NexOffice.
# Nunca exponha NEXOFFICE_SERVICE_KEY no frontend.
NEXOFFICE_BRIDGE_ENABLED=true
NEXOFFICE_SERVICE_KEY=
NEXOFFICE_CONNECT_TOKEN_TTL_SECONDS=600
# Mantém controles de status/lembrete/cancelamento de assinatura via NexOffice desligados
# até a integração ser explicitamente habilitada no ambiente operacional.
NEXOFFICE_SIGNATURE_BRIDGE_ENABLED=false

# DocFlow by DocWallet
DOCFLOW_ENABLED=true
DOCFLOW_DEFAULT_TENANT_NAME=DocFlow Workspace
DOCFLOW_EXTERNAL_INTEGRATIONS_ENABLED=false
# Futuro: habilitar execução externa somente com conectores, secrets no backend e política LGPD compatível.

# DocWallet Sign ICP-Brasil
# Deixe false até contratar/configurar provider ICP-Brasil real. Não use mock para produção.
ICP_SIGNATURE_ENABLED=false
ICP_SIGNATURE_PROVIDER=pending_provider
ICP_SIGNATURE_MODE=external_provider
ICP_SIGNATURE_PROVIDER_BASE_URL=
ICP_SIGNATURE_CALLBACK_SECRET=
# Provedores futuros possíveis: lacuna, bry, valid, certisign, soluti, outro PSC/provedor de assinatura.
# A1/A3/certificado em nuvem devem ser assinados via provider/componente seguro; nunca salve senha ou chave privada no frontend/backend.

# Blockchain / cobrança cripto
DOCWALLET_TREASURY_ADDRESS=0xSUA_CARTEIRA_RECEBEDORA
DOCWALLET_CHAIN_ID=137
DOCWALLET_NETWORK_NAME=Polygon
DOCWALLET_RPC_URL=https://polygon-rpc.com
DOCWALLET_EXPLORER_URL=https://polygonscan.com/tx
DOCWALLET_NATIVE_SYMBOL=POL
DOCWALLET_NOTARIZATION_PRICE_NATIVE=0.01
DOCWALLET_REQUIRE_ONCHAIN_VERIFY=true
DOCWALLET_ALLOW_UNVERIFIED_TX=false
